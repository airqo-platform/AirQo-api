# Copy to .env in src/calibrate. Restart the API after changing values.

# Local Flask development server (both v1 and v2 routes are available).
FLASK_APP=app.py
FLASK_RUN_PORT=4001
FLASK_DEBUG=false

# V2: POST /api/v2/calibrate/tool
# Loads default_rf.pkl (PM2.5) and default_lasso.pkl (PM10) from the bucket root.
# Use a bucket name, without gs:// or a folder suffix.
FORECAST_MODELS_BUCKET=airqo_prediction_bucket_dev

# V2 Google Cloud authentication: choose ONE option.
# 1. Leave the variable below unset and configure Application Default Credentials:
#    gcloud auth application-default login
#    On Google Cloud, an attached service account can provide these credentials.
# 2. Uncomment and set an absolute path to an existing service-account JSON.
#    The account needs storage.objects.get on the model objects.
#    Never commit service-account keys or your .env file.
# GOOGLE_APPLICATION_CREDENTIALS=D:/credentials/service-account.json

# V1: POST /api/v1/calibrate/tool (local pickle models).
# Relative paths assume the process starts from src/calibrate.
# These paths are also the outputs of the separate jobs/regression.py job.
# V2 ignores these settings and uses the bucket above.
RF_REG_MODEL=jobs/rf_reg_model.pkl
LASSO_MODEL=jobs/lasso_model.pkl

# V2 reference training: authenticated, durable jobs shared by API and workers.
# Set JWT_SECRET to the SAME secret used by AirQo auth-service (never a new key).
# Accepts Authorization: Bearer <login JWT> or Authorization: JWT <login JWT>.
# JWT_SECRET=
# Configure an isolated database with permissions to create indexes and use GridFS.
MONGO_URI=mongodb://localhost:27017
CALIBRATION_JOB_DATABASE=calibration_jobs
CALIBRATION_JOB_RETENTION_HOURS=24
CALIBRATION_TRAIN_MAX_ROWS=50000
# Start a separate worker with: python training_worker.py
# The worker deletes expired jobs/artifacts; keep at least one worker running.

# The standalone jobs/regression.py job requires GOOGLE_APPLICATION_CREDENTIALS
# pointing to a service-account JSON with access to its BigQuery source tables.
# It loads jobs/.env or inherited environment variables; the root .env is loaded
# by the Flask app, not automatically by that standalone job.
