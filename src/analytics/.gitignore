# Secrets — never commit these.
# The deploy workflows write google_application_credentials.json into this
# directory at build time, so it reappears on every deploy run.
google_application_credentials.json
*-service-account*.json
airqo-250220-*.json
.env
.env.*
!.env.example

# Runtime logs (TimedRotatingFileHandler writes analytics-api.log.<date>)
logs/
*.log
*.log.*

# Local scratch — captured BigQuery/API response dumps
file*.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Virtualenvs
venv/
env/
.venv/

# Editors / OS
.DS_Store
.idea/
